{
  "name": "motif-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fully local brand and marketing studio",
  "scripts": {
    "start": "pnpm run build && node --experimental-strip-types server.ts",
    "dev": "vite",
    "test": "pnpm run build && node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json",
    "dev:server": "node --experimental-strip-types --watch server.ts",
    "build": "pnpm run check && vite build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "cheerio": "1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "css-tree": "3.1.0",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.66.0",
    "playwright": "1.56.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
